  "note": "ExamSignatureV1 跨端共享 fixture（Android / iOS / 前端 notify_center_checks 单一事实源）。输入为标准化考试记录数组，expectedSignature 为既定算法输出。任何一端修改算法必须同步更新本文件并三端复验（Node 独立复算见 contract-fixtures/exams-signature-v1-compute.mjs）。数组顺序变化与无关字段变化必须产出与基线相同的 signature（不误报）；新增/删除/日期/时间/地点变化必须产出不同 signature（不漏报）。",
  "algorithm": {
    "normalize": "trim all string fields; nil/empty equivalent to empty string; records with blank courseName skipped (no stable identity)",
    "canonicalLine": "courseName|examDate|examTime|location|seatNo|examType",
    "fields": [
      "courseName: 课程名（业务必填，来自教务 kcmc -> course_name）",
      "examDate: 考试日期（YYYY-MM-DD，来自 ksrq -> exam_date）",
      "examTime: 考试时间区间原文（如 09:00-11:00，来自 kssj -> exam_time；trim 即可，不做分隔符归一化以免跨端漂移）",
      "location: 考试地点（jsmc/ksdd -> location；空串合法）",
      "seatNo: 座位号（zwh -> seat_no；空串合法）",
      "examType: 考试类型（kslxmc -> exam_type；数据源未稳定提供时为空串）",
      "不参与签名字段：courseId/semester（仅 native 侧可得，前端 /v2/exams 不返回，纳入会破坏跨端 ledger 去重）与 updatedAt/rawId 等无关字段"
    ],
    "sort": "utf8 byte order",
    "join": "\\n",
    "hash": "sha256 hex lowercase"
  },
