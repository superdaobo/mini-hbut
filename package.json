{
  "name": "mini-hbut",
  "version": "1.4.6",
  "description": "Mini-HBUT - 湖北工业大学教务助手",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prebuild": "node scripts/prepare_dist.mjs",
    "postinstall": "node scripts/patch_capacitor_tar_compat.mjs && node scripts/patch_tauri_cli_shim.mjs",
    "prebuild:web": "node scripts/prepare_dist.mjs",
    "dev": "node scripts/vite_run.mjs",
    "dev:lowmem": "node scripts/vite_dev_lowmem.mjs",
    "tauri:dev": "tauri dev",
    "tauri:dev:lowmem": "node scripts/tauri_dev_lowmem.mjs",
    "tauri:dev:static": "node scripts/tauri_dev_static.mjs",
    "build": "vite build",
    "build:web": "vite build",
    "build:website-demo": "node scripts/build_website_app_demo.mjs",
    "build:hot-bundle": "node scripts/build_hot_bundle.mjs",
    "test": "vitest run",
    "test:ci": "vitest run --config vitest.ci.config.ts",
    "coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test:bridge-compat": "vitest run --config vitest.ci.config.ts src/utils/phase1_security_contract.spec.ts src/utils/phase2a_bridge_runtime_contract.spec.ts",
    "test:bridge-http": "node scripts/test_bridge_http_contract.mjs",
    "test:pbt": "vitest run -t \"Property\"",
    "test:debug-bridge-contract": "node scripts/test_debug_bridge_contract.mjs",
    "test:debug-ui-capture": "node scripts/debug_capture_ui.mjs",
    "test:hot-update-framework": "node scripts/test_hot_update_framework.mjs",
    "test:more-module-bridge": "node scripts/test_more_module_bridge.mjs",
    "test:resource-share-network": "node scripts/test_resource_share_network.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev:debug-bridge": "node scripts/run_tauri_debug_dev.mjs",
    "cap:sync": "npm run build:web && npx cap sync",
    "cap:run:android": "npm run build:web && npx cap run android",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "check:dependency-alignment": "node scripts/check_dependency_alignment.mjs",
    "check:rustsec-acceptances": "node scripts/verify_rustsec_acceptances.mjs",
    "audit:dependencies": "node scripts/audit_dependencies.mjs",
    "check:all": "node scripts/check_all.mjs",
    "check:architecture": "node scripts/check_arch_guards.mjs && node scripts/check_god_files.mjs",
    "check:god-files": "node scripts/check_god_files.mjs",
    "check:god-files:strict": "node scripts/check_god_files.mjs --strict",
    "test:god-files": "node --test scripts/check_god_files.test.mjs",
    "check:release": "node scripts/check_release.mjs && node scripts/check_god_files.mjs --strict",
    "check:release-config": "node scripts/verify_release_config.mjs"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/app": "^6.0.1",
    "@capacitor/app-launcher": "^6.0.4",
    "@capacitor/browser": "^6.0.2",
    "@capacitor/core": "6.2.1",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "6.2.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/share": "^6.0.2",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@transistorsoft/capacitor-background-fetch": "^6.0.2",
    "@vueuse/core": "^14.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "katex": "0.16.47",
    "lucide-vue-next": "^1.0.0",
    "marked": "^18.0.9",
    "marked-katex-extension": "5.1.10",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "reka-ui": "2.10.1",
    "tailwind-merge": "^3.6.0",
    "tauri-plugin-keep-screen-on-api": "^0.1.4",
    "vue": "^3.5.41",
    "vue-router": "^4.2.5",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1",
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.1",
    "@tauri-apps/cli": "2.11.4",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "10.5.4",
    "esbuild": "^0.28.1",
    "fast-check": "^4",
    "material-symbols": "^0.45.8",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.3.0",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "vue-tsc": "^2.2.8"
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "7.5.22"
    }
  }
}
