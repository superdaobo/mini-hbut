# ============================================================
# Mini-HBUT Identity Core —— 环境变量模板
# 本文件只允许出现【占位值】。真实值只能放本地 .env（已被 Git 忽略）。
# 上线前必须在 Vercel 项目设置里按 Development/Preview/Production
# 三个环境分别配置，禁止三环境共用同一套值。
# ============================================================

# 环境分层：development | preview | production（骨架默认 development）
IDENTITY_ENVIRONMENT=development

# OIDC issuer。Production 必须固定为 canonical ASCII（Punycode）：
#   https://id.xn--vhq74jc2fzpchter27a.com
# Preview/Development 必须显式使用不同值，禁止与 Production 共用。
IDENTITY_ISSUER=<replace-me: preview/development 专用 issuer，如 https://identity-core-preview.vercel.app>

# PostgreSQL 连接串（Vercel Marketplace 集成，推荐 Neon）。
# readyz 只做连通性探测，绝不把连接串写入任何响应。
# 占位写法必须保留尖括号，避免被 SecretGuard 误判为真实凭据。
IDENTITY_DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>

# 后续 OIDC 实现（#620）使用的密钥占位（本 Issue 只定义名称）：
# JWKS 私钥 JSON / 签名密钥
IDENTITY_JWKS_JSON=<replace-me>
# pairwise subject 派生密钥（HMAC/随机高熵）
IDENTITY_PAIRWISE_SUBJECT_KEY=<replace-me>
# client_secret 加密 KEK（至少 32 字节随机值）
IDENTITY_CLIENT_SECRET_KEK=<replace-me>
# Web 接力 handoff secret 的 HMAC 密钥
IDENTITY_HANDOFF_HMAC_KEY=<replace-me>
# 允许的 Web 站点来源（逗号分隔，对应 auth.* / developer.*）
IDENTITY_WEB_ORIGINS=<replace-me: https://auth.xn--vhq74jc2fzpchter27a.com,https://developer.xn--vhq74jc2fzpchter27a.com>
# OIDC cookie 签名密钥（逗号分隔，至少一个；#620 oidc-provider cookies.keys）
IDENTITY_COOKIE_KEYS=<replace-me>
# Web BFF -> Core 内部服务令牌（至少 32 字节随机值；Preview/Production 必须独立）
IDENTITY_SERVICE_TOKEN=<replace-me>
# auth.* 站点 origin（#620 custom interaction 重定向目标）
IDENTITY_AUTH_ORIGIN=<replace-me: https://auth.xn--vhq74jc2fzpchter27a.com>
# 第一方静态 Client 配置（JSON 数组；仅 Preview/Test，Production 不配置，#620）
IDENTITY_STATIC_CLIENTS_JSON=<replace-me: []>
