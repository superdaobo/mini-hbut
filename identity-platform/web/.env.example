# ============================================================
# Mini-HBUT Identity Web —— 环境变量模板
# 只允许【占位值】；真实值放本地 .env（已被 Git 忽略）。
# Development / Preview / Production 三环境必须独立配置，禁止共用。
# ============================================================

# 环境分层：development | preview | production
IDENTITY_ENVIRONMENT=development

# Core API 基地址（Web 只通过 Core API 改状态，禁止直写 Identity DB）
IDENTITY_CORE_BASE_URL=<replace-me: 如 https://identity-core-preview.vercel.app>
# Web BFF -> Core 内部服务令牌（与同环境 Core 一致；Preview/Production 之间禁止复用）
IDENTITY_SERVICE_TOKEN=<replace-me>

# 对外展示的 issuer（缺省使用 Production canonical；Preview 必须显式改掉）
IDENTITY_PUBLIC_ISSUER=<replace-me: https://id.xn--vhq74jc2fzpchter27a.com>

# 站点公开 origin（proxy.ts 用它们做 Host 精确匹配，Punycode 形式）
AUTH_PUBLIC_ORIGIN=<replace-me: https://auth.xn--vhq74jc2fzpchter27a.com>
DEVELOPER_PUBLIC_ORIGIN=<replace-me: https://developer.xn--vhq74jc2fzpchter27a.com>

# Preview 部署域名（逗号分隔，显式识别；未列出的 *.vercel.app 一律 404 fail closed）
IDENTITY_PREVIEW_HOSTS=<replace-me: 如 my-web-preview.vercel.app>

# Developer Portal 自身登录用的 OIDC Client（后续 #624 使用）
DEVELOPER_OIDC_CLIENT_ID=<replace-me>
DEVELOPER_OIDC_CLIENT_SECRET=<replace-me>

# Web 会话加密密钥（至少 32 字节随机值）
WEB_SESSION_SECRET=<replace-me>
